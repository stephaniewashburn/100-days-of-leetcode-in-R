# Day 2: Filtering and grouping
#Your task:
#Find people who meet this criteria:
#Work in "Research"
#Worked more than 40 hours
#Have a performance_score of 90 or higher
#Give me their employee id, hours worked, and performance score
library(dplyr)

employees <- data.frame(
  employee_id = c(101, 102, 103, 104, 105, 106, 107, 108),
  department = c("Research", "Research", "Engineering", "Research",
                 "Engineering", "Research", "Engineering", "Research"),
  hours_worked = c(38, 45, 42, 50, 37, 41, 48, 35),
  performance_score = c(88, 92, 95, 76, 89, 91, 84, 97)
)

#######################################################################################
#My solution
workers_calc <- employees %>% 
  group_by(employee_id) %>% 
  filter(department == "Research") %>% 
  filter(hours_worked > 40) %>% 
  filter(performance_score >= 90) %>% 
  select(employee_id, hours_worked, performance_score)
print(workers_calc)




#Day 2 Task 2
#Your task: Return participants who meet all three conditions:

#age_group is "Older"
#accuracy is at least 0.85
#reaction_time is less than 600

library(dplyr)

participants <- data.frame(
  participant_id = c(201, 202, 203, 204, 205, 206, 207, 208),
  age_group = c("Young", "Older", "Young", "Older",
                "Young", "Older", "Young", "Older"),
  accuracy = c(0.91, 0.78, 0.85, 0.94, 0.72, 0.88, 0.96, 0.81),
  reaction_time = c(520, 680, 590, 610, 710, 570, 490, 650)
)
#######################################################################################
# My solution
participants_criteria <- participants %>% 
  filter(age_group == "Older") %>% 
  filter(accuracy >= 0.85) %>% 
  filter(reaction_time < 600) %>% 
  select(participant_id, accuracy, reaction_time)

print(participants_criteria)
