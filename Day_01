# Day 1: Group aggregation and ranking
# Your task: Find the employee with the highest average rating.
library(dplyr)

ratings <- data.frame(
  employee_id = c(301, 302, 301, 303, 302, 304, 301, 303, 304, 302, 303, 304),
  rating = c(4.5, 3.8, 4.8, 4.2, 4.1, 4.9, 4.6, 4.5, 4.7, 4.0, 4.4, 4.8)
)

ratings
##########################################################################
# My solution
rating_calc <- ratings %>%
  group_by(employee_id) %>%
  summarise(avg_rating = mean(rating)) %>%
  slice_max(avg_rating, n = 1)
print(rating_calc)
```


# Variation 2
# Your task: Find the employee_id with the highest total sales.

library(dplyr)

sales <- data.frame(
  employee_id = c(101, 102, 101, 103, 102, 104, 103, 101, 104, 102),
  sales_amount = c(250, 400, 300, 150, 350, 500, 450, 200, 300, 100)
)

sales
##########################################################################
# My solution
highest_total_sales <- sales %>% 
  group_by(employee_id) %>% 
  summarise(sale_sum = sum(sales_amount)) %>% 
  slice_max(sale_sum, n = 1)
print(highest_total_sales)


