#Variation 2
# Your task: Calculate the average hours worked for each department and arrange the departments from lowest average hours worked to highest.

library(dplyr)

departments <- data.frame(
  employee_id = c(201, 202, 203, 204, 205, 206, 207, 208, 209, 210, 211, 212),
  department = c("Research", "Engineering", "Research", "Marketing",
                 "Engineering", "Research", "Marketing", "Engineering",
                 "Research", "Marketing", "Engineering", "Marketing"),
  hours_worked = c(42, 48, 38, 40, 45, 46, 37, 50, 44, 43, 47, 39)
)



calc <- departments %>% 
  group_by(department) %>% 
  summarize(avg_hours = mean(hours_worked)) %>% 
  arrange(avg_hours)

print(calc)  
