#Day 3: Grouping + Summary Stats and Sorting
# Your task: Calculate the average accuracy for each condition and arrange the results from highest average accuracy to lowest.
library(dplyr)

experiments <- data.frame(
  participant_id = c(101, 102, 103, 104, 105, 106, 107, 108,
                     109, 110, 111, 112),
  condition = c("Control", "Treatment", "Control", "Treatment",
                "Control", "Treatment", "Control", "Treatment",
                "Control", "Treatment", "Control", "Treatment"),
  accuracy = c(82, 91, 88, 87, 79, 94, 85, 90, 91, 86, 84, 92)
)
experiments
################################################################

accuracy_calc <- experiments %>% 
  group_by(condition) %>% 
  summarise(avg = mean(accuracy)) %>% 
  arrange(desc(avg))

print(accuracy_calc)
  
  

