#Day 5
library(dplyr)

participants <- data.frame(
  participant_id = c(101, 102, 103, 104, 105, 106),
  age_group = c("Younger", "Older", "Younger", "Older", "Older", "Younger")
)

performance <- data.frame(
  participant_id = c(101, 102, 103, 104, 105, 106),
  accuracy = c(0.82, 0.91, 0.76, 0.88, NA, 0.95),
  reaction_time = c(510, 620, 480, 540, 590, 455)
)


#Create a dataframe called older_fast that:

#Combines participants and performance using participant_id.
#Keeps only Older adults.
#Removes participants whose accuracy is missing.
#Keeps only participants with a reaction time below 600 ms.
#Keeps only these columns:
#participant_id
#accuracy
#reaction_time
##########################################################################
#My solution
dataframe1 <- participants %>% 
  filter(age_group == "Older") 


dataframe2 <- performance %>% 
  filter(!is.na(accuracy)) %>% 
  filter(reaction_time < 600) 
  
combined_data <- left_join(dataframe1, dataframe2, by = "participant_id") %>% 
  select(participant_id, accuracy, reaction_time)

print(combined_data)

