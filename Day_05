# Your task

#Create a dataframe called research_high that:

#Keeps only employees in Research.
#Removes employees with a missing performance_score.
#Keeps employees with a performance score of at least 90.
#Joins the two datasets using employee_id.
#Keeps only:
#employee_id, performance_score, and hours_worked.

  library(dplyr)

employees <- data.frame(
  employee_id = c(201, 202, 203, 204, 205, 206),
  department = c("Research", "Engineering", "Research",
                 "Research", "Engineering", "Research")
)

scores <- data.frame(
  employee_id = c(201, 202, 203, 204, 205, 206),
  performance_score = c(88, 94, NA, 91, 86, 97),
  hours_worked = c(38, 42, 35, 45, 40, 39)
)



data1 <- employees %>% 
  filter(department == "Research")
  
data2 <- scores %>% 
  filter(!is.na(performance_score)) %>% 
  filter(performance_score >= 90)       
         
research_high <- left_join(data1, data2, by = "employee_id") %>% 
  select(employee_id, performance_score, hours_worked)

print(research_high)
