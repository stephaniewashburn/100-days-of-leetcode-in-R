# Day 14 — Complex Filtering with %in% and between()

# Your task: 

# Create a dataframe called selected_participants that:
# 
# Keeps participants whose condition is either "Treatment" or "Placebo" using %in%.
# Keeps participants whose reaction_time is between 475 and 550 milliseconds, using between().
# Keeps participants whose confidence is between 6 and 9.
# Creates a new variable called accuracy_percent by multiplying accuracy by 100.
# Arranges participants from highest to lowest accuracy percentage.
# Selects only:
# participant_id
# age_group
# condition
# accuracy_percent
# reaction_time
# confidence
# Prints the result.

library(dplyr)

participants <- data.frame(
  participant_id = 101:114,
  
  age_group = c(
    "Younger", "Older", "Older", "Younger", "Older",
    "Younger", "Older", "Younger", "Older", "Younger",
    "Older", "Younger", "Older", "Younger"
  ),
  
  condition = c(
    "Control", "Treatment", "Placebo", "Treatment", "Control",
    "Placebo", "Treatment", "Control", "Placebo", "Treatment",
    "Control", "Placebo", "Treatment", "Control"
  ),
  
  accuracy = c(
    0.91, 0.82, 0.87, 0.95, 0.79,
    0.89, 0.84, 0.93, 0.81, 0.90,
    0.86, 0.92, 0.83, 0.94
  ),
  
  reaction_time = c(
    480, 560, 525, 450, 610,
    500, 545, 470, 515, 490,
    585, 530, 505, 460
  ),
  
  confidence = c(
    8, 6, 7, 9, 5,
    8, 7, 9, 6, 8,
    7, 9, 6, 8
  )
)

selected_participants <- participants %>% 
  filter(condition %in% c("Treatment", "Placebo"),  
    between(reaction_time, 475, 550),
    between(confidence, 6, 9)) %>% 
  mutate(accuracy_percent = accuracy * 100) %>% 
  arrange(desc(accuracy_percent)) %>%
  select(participant_id, age_group, condition, accuracy_percent, reaction_time, confidence)

print(selected_participants)
